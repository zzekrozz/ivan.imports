# Stripe (solo servidor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IMPORTA_7_DIAS_PAYMENT_LINK_ID=
STRIPE_IMPORTA_7_DIAS_PRICE_ID=
STRIPE_IMPORTA_7_DIAS_EXPECTED_AMOUNT=17900

# IVI · Imports Vehicle Intelligence (solo servidor)
# El análisis permanece apagado hasta configurar proveedor, callback y almacenamiento durable.
IVI_ANALYSIS_ENABLED=false
IVI_BASE_URL=https://preview.example.com
IVI_CALLBACK_SECRET=
ONE_AUTO_API_KEY=
# true usa https://sandbox.oneautoapi.com; cambiar a false solo tras validación comercial y técnica.
ONE_AUTO_SANDBOX=true
ONE_AUTO_TIMEOUT_MS=20000
# Puede reutilizar Upstash/KV general si estas variables se omiten.
IVI_REDIS_REST_URL=
IVI_REDIS_REST_TOKEN=
IVI_REPORT_TTL_SECONDS=31536000
IVI_RAW_TTL_SECONDS=2592000

# Acompañamiento Completo / Primera Importación Contigo (solo servidor)
# Debe ser el Price ID real de Stripe cuyo precio final sea exactamente 997,00 € IVA incluido.
STRIPE_ACOMPANAMIENTO_PRICE_ID=

# Resend (solo servidor)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend sustituyó Audiences por Contacts + Segments. Usa SEGMENT_ID; AUDIENCE_ID queda como fallback compatible.
RESEND_IMPORTA_7_DIAS_SEGMENT_ID=
RESEND_IMPORTA_7_DIAS_AUDIENCE_ID=

# Estado durable e idempotencia (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace may inject these equivalent Upstash aliases:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Academia privada (solo servidor)
# Puede usar un Redis separado; si se omite, reutiliza UPSTASH_*/KV_* mediante el repositorio namespaced.
ACADEMY_REDIS_REST_URL=
ACADEMY_REDIS_REST_TOKEN=
# Genera tres secretos distintos, aleatorios y de al menos 32 caracteres.
ACADEMY_AUTH_SECRET=
ACADEMY_DATA_SECRET=
ACADEMY_SESSION_SECRET=
ACADEMY_SESSION_TTL_SECONDS=2592000
ACADEMY_CODE_TTL_SECONDS=600
ACADEMY_RESEND_COOLDOWN_SECONDS=60
# Debe coincidir con VERCEL_ENV: academy/preview/... o academy/production/...
ACADEMY_CONTENT_BLOB_PATHNAME=
ACADEMY_FROM_EMAIL=
ACADEMY_BASE_URL=https://ivanimports.es
# Solo QA controlado; mínimo 24 caracteres y nunca se expone en HTML, query strings o el repositorio.
ACADEMY_DEMO_TOKEN=
ACADEMY_DEMO_SESSION_TTL_SECONDS=3600
# Código único de acceso a Mission Control. Solo se valida en servidor.
MISSION_CONTROL_ACCESS_CODE=
# Mission Control reutiliza Redis y los secretos privados de Academia, pero escribe
# exclusivamente en el namespace mission-control:v1:user:<subject>.
# Administración server-to-server; token aleatorio de al menos 32 caracteres.
ACADEMY_ADMIN_API_URL=https://ivanimports.es/api/academy/admin/entitlement
ACADEMY_ADMIN_API_TOKEN=

# Producto privado (Vercel Blob privado, stores aislados)
# VERCEL_OIDC_TOKEN lo inyecta Vercel y `vercel link`; es la autenticación primaria.
# El fallback estático queda desactivado salvo autorización explícita.
ACADEMY_BLOB_ALLOW_STATIC_TOKEN_FALLBACK=false
ACADEMY_PREVIEW_BLOB_STORE_ID=
ACADEMY_PREVIEW_BLOB_READ_WRITE_TOKEN=
ACADEMY_PRODUCTION_BLOB_STORE_ID=
ACADEMY_PRODUCTION_BLOB_READ_WRITE_TOKEN=
IMPORTA_7_DIAS_GUIDE_BLOB_PATHNAME=
IMPORTA_7_DIAS_WORKBOOK_BLOB_PATHNAME=
IMPORTA_7_DIAS_DOWNLOAD_SIGNING_SECRET=
IMPORTA_7_DIAS_DOWNLOAD_TTL_SECONDS=604800

# Operación y soporte (solo servidor)
IMPORTA_7_DIAS_BASE_URL=https://ivanimports.es
IMPORTA_7_DIAS_SUPPORT_PHONE_E164=
IMPORTA_7_DIAS_ADMIN_EMAIL=
IMPORTA_7_DIAS_ADMIN_API_TOKEN=
# Mission Control Web Push. Generate the VAPID pair with: npx web-push generate-vapid-keys
CONTROL_VAPID_PUBLIC_KEY=
CONTROL_VAPID_PRIVATE_KEY=
CONTROL_VAPID_SUBJECT=mailto:soporte@ivanimports.es
# Protects /api/control/reminders/dispatch. Vercel Cron sends this as Bearer automatically.
CRON_SECRET=
