{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src/kairos-budget",
    "outDir": "assets/kairos-budget",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/kairos-budget/**/*.ts"]
}
